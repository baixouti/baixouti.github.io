# Copie para .env (local) ou cadastre como Secrets no GitHub.
# Nenhum destes valores vai para o repositorio.

# --- Telegram (obrigatorio) ---
TELEGRAM_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_ADMIN_CHAT_ID=123456789
TELEGRAM_CANAL=@baixouti

# --- Afiliados (preencha conforme for aprovado em cada um) ---
AMAZON_TAG=          # so preencha DEPOIS de ser aprovado
ML_TOOL_ID=

# Opcional: token da API do Mercado Livre, so para montar catalogo em massa
ML_ACCESS_TOKEN=
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# --- Opcional: encurtador proprio (Cloudflare Worker) ---
ENCURTADOR_BASE=
